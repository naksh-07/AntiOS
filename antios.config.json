{
  "version": "1.0",
  "name": "AntiOS-StudyLab-Adapter",
  "protected_zones": [
    ".agents",
    "framework"
  ],
  "protected_domain_paths": [
    "rslib"
  ],
  "forbidden_patterns": [
    "rslib~*"
  ],
  "test_runners": [
    {
      "name": "typescript",
      "manifest": "package.json",
      "scripts": ["vitest:once", "test"],
      "default_command": ["npm", "run", "vitest:once"],
      "timeout_seconds": 60
    },
    {
      "name": "python",
      "manifest": "pyproject.toml",
      "default_command": ["pytest"],
      "timeout_seconds": 60
    }
  ],
  "policies": {
    "fail_closed": true,
    "enforce_working_tree_cleanliness": true,
    "enforce_same_change_set": true
  }
}

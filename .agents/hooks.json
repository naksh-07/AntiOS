{
  "antios-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python framework/hooks/pre_invocation.py"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python framework/hooks/pre_tool_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python framework/hooks/post_tool_use.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python framework/hooks/gate.py"
      }
    ]
  }
}
